# Empty API URL enables clearly labeled, browser-local rehearsal mode.
NEXT_PUBLIC_API_URL=
# For local API: NEXT_PUBLIC_API_URL=http://127.0.0.1:8000
AKAMAI_BASE_URL=
AKAMAI_API_KEY=
AKAMAI_MODEL=
AI_MODE=rehearsal
# direct = Akamai model orchestrates Strands tools; tool = Bedrock orchestrates Akamai tool.
STRANDS_MODEL_MODE=direct
BEDROCK_MODEL_ID=
AWS_REGION=us-east-1
ALLOWED_ORIGIN=http://127.0.0.1:3000
DEMO_AUTH_ENABLED=true
# Generate a long random SESSION_SECRET for deployed environments.
SESSION_SECRET=
